# Miljövariabler för AI Enterprise. Kopiera aldrig riktiga värden hit: den här filen ligger i git.
# Den riktiga filen heter .env, ligger bredvid den här och står i .gitignore.
# Var varje variabel ska sättas i drift står i docs/command-center/DEPLOY.md.

# --- Läses ur .env av den lokala servern ---------------------------------------------------------
# Hash av grundarens åtkomstkod för den lokala servern. Sätts med: py -m aie dashboard set-code --founder Yorgo
AIE_DASHBOARD_CODE_YORGO=
AIE_DASHBOARD_CODE_ROBIN=

# --- Läses ur miljön (GitHub-hemligheter i Actions; lokalt bara om du själv kör kommandot) --------
# Agenterna (gratismodeller) och chatten i Command Center
GROQ_API_KEY=
# Snapshoten, kön och tillståndskopiorna i Cloudflare KV (py -m aie publish, control ingest, state)
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
KV_NAMESPACE_ID=
# Krypteringsnyckeln för databaskopiorna i KV (scripts/state.sh)
STATE_KEY=
# Notiser (py -m aie notify). Saknas de hoppas kanalen över. NOTIFY_TO är valfri: mottagare, med komma emellan.
NTFY_TOPIC=
GMAIL_USER=
GMAIL_APP_PASSWORD=
NOTIFY_TO=

# --- Bara i Cloudflare Pages (Settings > Variables and Secrets), aldrig i GitHub ----------------
# Inloggningen (D-094). Skapas med: py -m aie command-center make-code --founder Yorgo, och make-secret
FOUNDER_CODE_HASHES=
SESSION_SECRET=
GITHUB_READ_TOKEN=
GITHUB_DISPATCH_TOKEN=
